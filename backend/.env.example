DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolportal?schema=public"
CORS_ORIGINS="http://localhost:5173"
SEED_PASSWORD="ChangeMe123!"
# Switch to postgresql://user:password@host:5432/dbname before staging/production
# Required: development | test | staging | production. The API refuses to start when unset (BL-51).
NODE_ENV="development"
# Outside development/test the API refuses to start unless this is >= 32 random characters and not a
# placeholder; also DATABASE_URL, CORS_ORIGINS and FRONTEND_URL must be set. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (Refresh tokens are opaque random values stored hashed — there is no refresh-token secret.)
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL="15m"
# Reverse proxy hops to trust for the client IP (rate limiting). Leave unset when the API is reached
# directly; behind one load balancer/TLS proxy set "1" (BL-12). Also accepts true/false or subnets.
TRUST_PROXY=""
# Admin-assisted parent password reset (BL-64): auto (default) = on only while SMTP is not
# configured; enabled | disabled force it.
ADMIN_PASSWORD_RESET="auto"
# Optional malware scanning of uploads via a clamd daemon (BL-52). Unset = no scanning.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
# File storage (BL-10): local = UPLOADS_DIR (development/test only); s3 is required elsewhere.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# One-time first administrator (BL-22): npm run bootstrap:super-admin. Set only for that run.
# BOOTSTRAP_SUPER_ADMIN_IDENTIFIER=""
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=""
# Payment gateways — leave a provider's vars entirely unset to disable it (falls back to the
# stub adapter in development/test only). Setting only some of a provider's vars is a startup
# error outside development/test.
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_RETURN_URL=""
JAZZCASH_API_URL=""
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_RETURN_URL=""
EASYPAISA_API_URL=""
# Required outside development/test if the stub webhook route is reachable (it shouldn't be, in
# a real deployment, but this guards against it being left wired up by mistake).
PAYMENT_STUB_WEBHOOK_SECRET=""
# Push notifications (FCM) — leave all three unset to disable (falls back to a logging no-op
# adapter in every environment, not just development/test — there is no "stub that fakes success"
# for push the way there is for payments, since nothing consumes a push confirmation). Setting
# only some of these is a startup error outside development/test. FIREBASE_PRIVATE_KEY should
# contain literal \n sequences (not real newlines) exactly as most secret managers store it.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Email (forgot/reset-password) — leave all five unset to disable (falls back to a logging
# no-op adapter that logs the reset link instead of emailing it, in every environment — no real
# SMTP account exists in this environment). Setting only some of these is a startup error outside
# development/test.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Used to build the reset-password link sent by the forgot-password flow. Defaults to the
# staff-console dev origin when unset.
FRONTEND_URL="http://localhost:5173"
# AI drafting (Sprint K) — leave unset to use the stub provider (no real Anthropic API key exists
# in this environment; the stub returns a clearly-labeled placeholder instead of a fabricated
# suggestion).
ANTHROPIC_API_KEY=""